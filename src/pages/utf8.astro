---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Public UTF-8 - Jasper Morgal">
  <div id="utf8-tool">
    <section>
      <h1>Public UTF-8</h1>
      <div id="bits"></div>
    </section>
    <hr />
    <section id="decoded-section">
      <h1>Decoded Text</h1>
      <p id="decoded"></p>
    </section>
  </div>
  <script>
    import "@/scripts/utf8";
  </script>
</Layout>

<style>
  @media (min-width: 551px) {
    :global(.nav-home) {
      margin-left: 8px;
    }
  }

  :global(html) {
    overflow: hidden;
  }

  :global(body) {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 8px);
    margin: 8px 0 0;
    overflow: hidden;
  }

  #utf8-tool {
    display: grid;
    grid-template-columns: 1fr 2px 1fr;
    flex: 1;
    min-height: 0;
  }

  section {
    overflow: auto;
    min-width: 0;
  }

  section:first-child {
    display: grid;
    justify-items: center;
  }

  #bits :global(.byte) {
    display: grid;
    gap: 4px;
  }

  #bits {
    font-family: "Menlo", monospace;
    margin: 5px 16px 16px;
    position: relative;
    width: calc(176px + 2.5ch);
  }

  #decoded {
    margin: 16px;
    text-align: left;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  #bits :global(.byte) {
    grid-template-columns: repeat(8, 18px) 2.5ch;
    height: 18px;
    position: absolute;
    top: 0;
    left: 0;
  }

  #bits :global(input) {
    width: 18px;
    height: 18px;
    margin: 0;
  }

  #bits :global(.hex) {
    text-align: right;
  }

  hr {
    height: auto;
    margin: 0;
  }

  @media (max-width: 550px) {
    #utf8-tool {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 2px 1fr;
    }
  }
</style>
