---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Mancala - Jasper Morgal">
  <h1>Mancala</h1>
  <canvas id="board"></canvas>
  <p id="status">Your turn</p>
  <p>
    Look ahead:
    <label>
      <select id="lookahead">
        <option value="1">1 move</option>
        <option value="2">2 moves</option>
        <option value="4">4 moves</option>
        <option value="8">8 moves</option>
        <option value="16">16 moves</option>
        <option value="0" selected>Max</option>
      </select>
    </label>
  </p>
  <p class="pointer" id="newgame">New game</p>
  <script>
    import "@/scripts/mancala";
  </script>
</Layout>

<style>
  p {
    font-family: "Menlo", monospace;
  }
  select {
    vertical-align: top;
  }
  canvas {
    display: block;
    width: min(100%, 900px, 150vh);
    aspect-ratio: 84 / 32;
    margin: 0 auto;
    touch-action: manipulation;
  }
  @media (max-width: 600px) and (orientation: portrait) {
    canvas {
      width: min(100%, 26vh);
      aspect-ratio: 32 / 84;
    }
  }
</style>
