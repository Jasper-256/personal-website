---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Public Chat - Jasper Morgal">
  <h1>Public Chat</h1>
  <p id="history"></p>
  <form id="frm" hidden>
    <input type="text" name="Message" placeholder="Message" maxlength="50" size="40" autocomplete="off" required />
    <button type="submit" id="submit-form" class="pointer">Send</button>
  </form>
  <script>
    import "@/scripts/chat";
  </script>
</Layout>
