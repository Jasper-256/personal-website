---
import Layout from "@/layouts/Layout.astro";
import eciCsv from "@/data/epoch/eci_scores.csv?raw";
import metrCsv from "@/data/epoch/metr_time_horizons_external.csv?raw";
import metadataCsv from "@/data/epoch/model_metadata.csv?raw";
import source from "@/data/epoch/source.json";
import { buildForecast, formatDuration, formatEciRate, horizonMinutes, toYear, trendRate, trendSlopeAt } from "@/scripts/ai-frontier-forecast-model";

// Computed at build time from Epoch's raw data; refresh it with `npm run update:epoch`.
const model = buildForecast({ eci: eciCsv, metr: metrCsv, metadata: metadataCsv });

// Lab colors (validated categorical slots). Labs without a slot share the neutral "other" color.
const ORG_COLORS: Record<string, string> = {
  OpenAI: "var(--series-openai)",
  Anthropic: "var(--series-anthropic)",
  "Google DeepMind": "var(--series-google)",
};
const OTHER_COLOR = "var(--series-other)";
const orgsPresent = new Set(model.points.map((p) => p.org));
const legend = [
  ...Object.entries(ORG_COLORS).filter(([org]) => orgsPresent.has(org)),
  ...([...orgsPresent].some((org) => !(org in ORG_COLORS)) ? [["Other labs", OTHER_COLOR]] : []),
];
const colors = Object.fromEntries([...orgsPresent].map((org) => [org, ORG_COLORS[org] ?? OTHER_COLOR]));

const fmtLongDate = (ms: number) =>
  new Date(ms).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const trendName = model.trend.kind === "exponential" ? "exponential" : "linear";
const pageData = JSON.stringify({ ...model, colors }).replace(/</g, "\\u003c");
---

<Layout title="AI Frontier Forecast - Jasper Morgal">
  <h1>AI Frontier Forecast</h1>
  <p class="lede">
    This chart graphs every model to push the ECI frontier forward. {trendName === "exponential" ? "An" : "A"} {trendName} regression is run over these models and their
    release dates to predict the consistent trend of increasing ECI. The milestone dates are ECI thresholds from the
    <a
      href="https://www.aifuturesmodel.com/p?v=2&base=eli-08-16-26&ed=q3.5&rcl=-0.5&suard=7.052322627593112&eudt=3.0130366136756046&ila=60&icaec=1.5"
      target="_blank"
      rel="noopener">Q3.5 update</a
    > of the AI Futures Model, which this page attempts to concretely predict using only
    current ECI data.
  </p>

  <div class="milestones">
    {
      model.milestones.map((m) => (
        <div class="milestone" data-target={m.date ?? ""}>
          <div class="ms-label">{m.label}</div>
          <div class="ms-date">{m.date === null ? "Not on current trend" : fmtLongDate(m.date)}</div>
          <div class="ms-countdown" aria-live="off">&nbsp;</div>
          <div class="ms-eci">ECI {m.eci} • ~{formatDuration(horizonMinutes(model.horizon, m.eci))}</div>
        </div>
      ))
    }
  </div>
  <p class="trend-note">
    Frontier trend: {model.trend.kind === "exponential" ? "ECI " : ""}{trendRate(model.trend)}{
      model.trend.kind === "exponential" && (
        <>
          {" · "}currently <span id="current-rate">{formatEciRate(trendSlopeAt(model.trend, toYear(Date.now())))}</span>
        </>
      )
    }
  </p>

  <figure class="viz">
    <ul class="legend" aria-label="Legend">
      {
        legend.map(([name, color]) => (
          <li>
            <span class="key-dot" style={`--c: ${color}`} />
            {name}
          </li>
        ))
      }
      <li><span class="key-line key-step"></span>Frontier</li>
      <li><span class="key-line key-trend"></span>{trendName === "exponential" ? "Exponential" : "Linear"} trend</li>
    </ul>
    <div class="chart" id="chart">
      <div class="zoom" id="zoom" role="group" aria-label="Zoom the chart">
        <button type="button" data-view="all" aria-pressed="true">All</button>
        <button type="button" data-view="modern" aria-pressed="false">Modern</button>
      </div>
      <svg id="chart-svg" role="img" aria-label={`Frontier ECI score by model release date, with ${trendName === "exponential" ? "an exponential" : "a linear"} trend line`}></svg>
      <div class="tooltip" id="tooltip" hidden>
        <div class="tt-name"><span class="tt-key" id="tt-key"></span><span id="tt-name"></span></div>
        <div class="tt-meta" id="tt-meta"></div>
        <div class="tt-stats">
          <span class="tt-stat-value" id="tt-value"></span>
          <span class="tt-stat-label">ECI</span>
          <span class="tt-stat-value" id="tt-horizon"></span>
          <span class="tt-stat-label">predicted 50% time horizon</span>
        </div>
      </div>
    </div>
  </figure>

  <p class="source">
    Data: <a href="https://epoch.ai/eci?view=graph&tab=release-date" target="_blank" rel="noopener">Epoch AI, Capabilities Index</a> (CC BY 4.0), retrieved {source.retrieved}.
  </p>

  <script type="application/json" id="eci-data" set:html={pageData} />

  <style is:global>
    :root {
      --surface: #fcfcfc;
      --ink: #0b0b0b;
      --ink-2: #52514e;
      --ink-muted: #807e78;
      --grid: #e8e7e1;
      --axis: #c3c2b7;
      --series-openai: #2a78d6;
      --series-anthropic: #eb6834;
      --series-google: #1baf7a;
      --series-other: #8f8d86;
      --step: #b9b8b0;
      --trend: #0b0b0b;
      --tooltip-bg: #ffffff;
      --tooltip-border: rgba(11, 11, 11, 0.1);
      --tooltip-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --surface: #141414;
        --ink: #f0efec;
        --ink-2: #c3c2b7;
        --ink-muted: #8d8b85;
        --grid: #262625;
        --axis: #3a3a37;
        --series-openai: #3987e5;
        --series-anthropic: #d95926;
        --series-google: #199e70;
        --series-other: #77756f;
        --step: #4a4a46;
        --trend: #f0efec;
        --tooltip-bg: #1e1e1e;
        --tooltip-border: rgba(255, 255, 255, 0.1);
        --tooltip-shadow: none;
      }
    }

    .lede {
      max-width: 40rem;
      margin: 0 auto;
    }

    .milestones {
      display: flex;
      justify-content: center;
      gap: 1rem 3.5rem;
      flex-wrap: wrap;
      margin-top: 1.75rem;
    }
    .milestone {
      min-width: 15rem;
    }
    .ms-label {
      font-size: 0.95rem;
      color: var(--ink-2);
    }
    .ms-date {
      margin-top: 0.15rem;
      font-size: 2rem;
      font-weight: 600;
      line-height: 1.15;
      letter-spacing: -0.01em;
    }
    .ms-countdown {
      margin-top: 0.35rem;
      font-size: 1.05rem;
      font-variant-numeric: tabular-nums;
    }
    .ms-countdown .unit {
      margin: 0 0.45em 0 0.08em;
      font-size: 0.8em;
      color: var(--ink-muted);
    }
    .ms-countdown .unit:last-child {
      margin-right: 0;
    }
    .ms-eci {
      margin-top: 0.2rem;
      font-size: 0.8rem;
      color: var(--ink-muted);
    }

    .trend-note {
      margin: 1.25rem 0 0;
      font-size: 0.85rem;
      color: var(--ink-muted);
    }

    .viz {
      max-width: 960px;
      margin: 1.5rem auto 0;
      padding: 0;
    }

    .legend {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.35rem 1.1rem;
      margin: 0 0 0.5rem;
      padding: 0;
      font-size: 0.85rem;
      color: var(--ink-2);
    }
    .legend li {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .key-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--c);
    }
    .key-line {
      width: 18px;
      height: 0;
      border-top: 2px solid var(--step);
    }
    .key-trend {
      border-top: 2px dashed var(--trend);
      opacity: 0.55;
    }

    .chart {
      position: relative;
      width: 100%;
    }
    #chart-svg {
      display: block;
      width: 100%;
      overflow: visible;
      touch-action: pan-y;
      font-family: inherit;
    }

    .zoom {
      position: absolute;
      top: 34px;
      left: 46px;
      z-index: 1;
      display: inline-flex;
      gap: 2px;
      padding: 2px;
      background: var(--surface);
      border: 1px solid var(--grid);
      border-radius: 999px;
    }
    .zoom button {
      font: inherit;
      font-size: 0.75rem;
      line-height: 1;
      padding: 5px 11px;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: var(--ink-muted);
      cursor: pointer;
      transition:
        background-color 150ms ease,
        color 150ms ease;
    }
    .zoom button:hover {
      color: var(--ink);
    }
    .zoom button[aria-pressed="true"] {
      background: var(--ink);
      color: var(--surface);
    }
    .zoom button:focus-visible {
      outline: 2px solid var(--series-openai);
      outline-offset: 1px;
    }

    .tooltip {
      position: absolute;
      top: 0;
      left: 0;
      pointer-events: none;
      text-align: left;
      background: var(--tooltip-bg);
      border: 1px solid var(--tooltip-border);
      box-shadow: var(--tooltip-shadow);
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 0.8rem;
      color: var(--ink-2);
      white-space: nowrap;
      z-index: 2;
    }
    .tt-name {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--ink);
    }
    .tt-key {
      width: 12px;
      height: 0;
      border-top: 2px solid;
    }
    .tt-meta {
      margin-top: 1px;
      color: var(--ink-muted);
    }
    .tt-stats {
      margin-top: 7px;
      padding-top: 7px;
      border-top: 1px solid var(--grid);
      display: grid;
      grid-template-columns: auto auto;
      justify-content: start;
      align-items: baseline;
      gap: 2px 8px;
    }
    .tt-stat-value {
      font-weight: 600;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
    }
    .tt-stat-label {
      color: var(--ink-muted);
    }

    .source {
      margin-top: 1.5rem;
      font-size: 0.8rem;
      color: var(--ink-muted);
    }

    /* SVG chrome */
    #chart-svg .grid line {
      stroke: var(--grid);
      stroke-width: 1;
    }
    #chart-svg .baseline {
      stroke: var(--axis);
      stroke-width: 1;
    }
    #chart-svg .tick {
      fill: var(--ink-muted);
      font-size: 11px;
      font-variant-numeric: tabular-nums;
    }
    #chart-svg .axis-title {
      fill: var(--ink-muted);
      font-size: 11px;
    }
    #chart-svg .step {
      fill: none;
      stroke: var(--step);
      stroke-width: 2;
      stroke-linejoin: round;
      stroke-linecap: round;
    }
    #chart-svg .trend {
      stroke: var(--trend);
      stroke-width: 1.5;
      stroke-dasharray: 5 4;
      opacity: 0.55;
    }
    #chart-svg .trend-ext {
      opacity: 0.22;
    }
    #chart-svg .trend-label {
      fill: var(--ink-2);
      font-size: 11px;
    }
    #chart-svg .whisker {
      stroke-width: 1.5;
      stroke-linecap: round;
      opacity: 0.35;
    }
    #chart-svg .dot {
      stroke: var(--surface);
      stroke-width: 2;
      transition: r 120ms ease;
    }
    #chart-svg .point {
      cursor: pointer;
      outline: none;
    }
    #chart-svg .point.is-active .dot {
      r: 7px;
    }
    #chart-svg .point:focus-visible .dot {
      stroke: var(--ink);
    }
    #chart-svg .label {
      fill: var(--ink-2);
      font-size: 11.5px;
      paint-order: stroke;
      stroke: var(--surface);
      stroke-width: 4px;
      stroke-linejoin: round;
    }
    #chart-svg .crosshair {
      stroke: var(--axis);
      stroke-width: 1;
    }

    @media (prefers-reduced-motion: no-preference) {
      #chart-svg.animate .step {
        animation: draw 1.4s cubic-bezier(0.3, 0.6, 0.2, 1) both;
      }
      #chart-svg.animate .point,
      #chart-svg.animate .label {
        animation: pop 400ms ease-out both;
        animation-delay: calc(var(--i) * 45ms + 200ms);
      }
      #chart-svg.animate .trend,
      #chart-svg.animate .trend-label {
        animation: fade 600ms ease-out 1.1s both;
      }
    }
    @keyframes draw {
      from {
        stroke-dashoffset: var(--len);
        stroke-dasharray: var(--len);
      }
      to {
        stroke-dashoffset: 0;
        stroke-dasharray: var(--len);
      }
    }
    @keyframes pop {
      from {
        opacity: 0;
      }
    }
    @keyframes fade {
      from {
        opacity: 0;
      }
    }
  </style>

  <script>
    import {
      countdownParts,
      formatDuration,
      formatEciRate,
      horizonMinutes,
      MODERN_VIEW_START,
      toYear,
      trendAt as trendEci,
      trendRate,
      trendSlopeAt,
      type Forecast,
    } from "@/scripts/ai-frontier-forecast-model";

    const data: Forecast & { colors: Record<string, string> } = JSON.parse(document.getElementById("eci-data")!.textContent!);
    const { trend, horizon, colors } = data;
    const points = data.points.map((p) => ({ ...p, x: toYear(p.date) }));
    const n = points.length;
    const trendAt = (x: number) => trendEci(trend, x);

    const SVG_NS = "http://www.w3.org/2000/svg";
    const fmtDate = (iso: string) =>
      new Date(iso + "T00:00:00Z").toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });

    // Current trend rate, recomputed for today (the build-time value goes stale between deploys)
    const currentRate = document.getElementById("current-rate");
    if (currentRate) currentRate.textContent = formatEciRate(trendSlopeAt(trend, toYear(Date.now())));

    // Countdowns to the milestone dates rendered at build time
    const countdowns = [...document.querySelectorAll<HTMLElement>(".milestone")]
      .filter((node) => node.dataset.target)
      .map((node) => ({ target: Number(node.dataset.target), countdown: node.querySelector<HTMLElement>(".ms-countdown")! }));
    const tick = () => {
      const now = Date.now();
      for (const { target, countdown } of countdowns) {
        const parts = countdownParts(now, target);
        if (!parts.length) {
          countdown.textContent = "Reached on trend";
          continue;
        }
        countdown.replaceChildren();
        for (const [value, unit] of parts) {
          const u = document.createElement("span");
          u.className = "unit";
          u.textContent = unit;
          countdown.append(value, u);
        }
      }
    };
    tick();
    setInterval(tick, 1000);

    const chart = document.getElementById("chart")!;
    const svg = document.getElementById("chart-svg") as unknown as SVGSVGElement;
    const tooltip = document.getElementById("tooltip")!;

    const el = <K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number>, parent?: Element) => {
      const node = document.createElementNS(SVG_NS, tag);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
      parent?.append(node);
      return node;
    };

    // Zoom presets only change the visible window; the frontier and trend fit stay as computed
    const VIEW_STARTS = { all: Math.floor(points[0].x), modern: toYear(MODERN_VIEW_START) };
    let view: keyof typeof VIEW_STARTS = "all";

    // Axis ranges follow the visible data: whole years across, and a little headroom around the scores
    function domain() {
      const X0 = VIEW_STARTS[view];
      const X1 = Math.ceil(points[n - 1].x + 0.08);
      const inView = points.filter((p) => p.x >= X0);
      const entering = points.filter((p) => p.x < X0).at(-1); // the record the staircase carries into view
      const lows = [...inView.map((p) => p.lo ?? p.eci), ...(entering ? [entering.eci] : [])];
      const highs = inView.map((p) => p.hi ?? p.eci);
      const Y0 = Math.floor((Math.min(...lows) - 1) / 5) * 5;
      const Y1 = Math.ceil((Math.max(...highs) + 1) / 10) * 10;
      return { X0, X1, Y0, Y1, Y_STEP: Y1 - Y0 > 100 ? 20 : 10 };
    }

    let firstRender = true;
    let activeIndex = -1;
    // Indexed like `points`; null for models outside the current zoom
    let positions: ({ cx: number; cy: number } | null)[] = [];
    let pointNodes: (SVGGElement | null)[] = [];
    let activate: (i: number) => void = () => {};

    function render() {
      const { X0, X1, Y0, Y1, Y_STEP } = domain();
      const visible = (i: number) => points[i].x >= X0;
      const firstVisible = points.findIndex((p) => p.x >= X0);
      const width = chart.clientWidth;
      const narrow = width < 560;
      const height = Math.round(Math.max(320, Math.min(520, width * 0.58)));
      const m = { top: 26, right: narrow ? 12 : 20, bottom: 30, left: 38 };
      const iw = width - m.left - m.right;
      const ih = height - m.top - m.bottom;
      const sx = (x: number) => m.left + ((x - X0) / (X1 - X0)) * iw;
      const sy = (y: number) => m.top + (1 - (y - Y0) / (Y1 - Y0)) * ih;

      svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
      svg.setAttribute("height", String(height));
      svg.replaceChildren();
      svg.classList.toggle("animate", firstRender);

      // Grid + ticks
      const grid = el("g", { class: "grid" }, svg);
      for (let y = Math.ceil(Y0 / Y_STEP) * Y_STEP; y <= Y1; y += Y_STEP) {
        el("line", { x1: m.left, x2: width - m.right, y1: sy(y), y2: sy(y) }, grid);
        const t = el("text", { class: "tick", x: m.left - 8, y: sy(y), "text-anchor": "end", "dominant-baseline": "middle" }, svg);
        t.textContent = String(y);
      }
      for (let x = X0; x <= X1; x += 0.5) {
        const isYear = Number.isInteger(x);
        if (!isYear && (narrow || X1 - X0 > 5)) continue;
        if (isYear) el("line", { x1: sx(x), x2: sx(x), y1: m.top, y2: m.top + ih }, grid);
        const t = el("text", { class: "tick", x: sx(x), y: height - 10, "text-anchor": "middle" }, svg);
        t.textContent = isYear ? String(x) : "Jul";
        if (!isYear) t.setAttribute("opacity", "0.6");
      }
      el("line", { class: "baseline", x1: m.left, x2: width - m.right, y1: m.top + ih, y2: m.top + ih }, svg);
      const yTitle = el("text", { class: "axis-title", x: m.left - 8, y: m.top - 14, "text-anchor": "end" }, svg);
      yTitle.textContent = "ECI";

      // Crosshair (hidden until hover)
      const crosshair = el("line", { class: "crosshair", y1: m.top, y2: m.top + ih, visibility: "hidden" }, svg);

      // Trend line (sampled, so curved fits draw correctly): solid-dash across the data, fainter extension to the chart edges
      const xa = Math.max(points[0].x, X0);
      const xb = points[n - 1].x;
      const clip = el("clipPath", { id: "plot-clip" }, el("defs", {}, svg));
      el("rect", { x: m.left, y: m.top, width: iw, height: ih }, clip);
      const trendLayer = el("g", { "clip-path": "url(#plot-clip)" }, svg);
      const seg = (x1: number, x2: number, cls: string) => {
        const steps = Math.max(1, Math.ceil(Math.abs(x2 - x1) * 24));
        let path = "";
        for (let k = 0; k <= steps; k++) {
          const x = x1 + ((x2 - x1) * k) / steps;
          path += `${k ? "L" : "M"}${sx(x).toFixed(1)},${sy(trendAt(x)).toFixed(1)}`;
        }
        el("path", { class: cls, d: path, fill: "none" }, trendLayer);
      };
      if (xa > X0) seg(X0, xa, "trend trend-ext");
      seg(xa, xb, "trend");
      seg(xb, X1, "trend trend-ext");

      if (!narrow) {
        // Slide the label along the visible line to the spot farthest from any dot or whisker
        const tl = el("text", { class: "trend-label", "text-anchor": "middle" }, svg);
        tl.textContent = trendRate(trend);
        const half = tl.getComputedTextLength() / 2;
        const obstacles: [number, number][] = [];
        points.forEach((p, i) => {
          if (!visible(i)) return;
          obstacles.push([sx(p.x), sy(p.eci)]);
          if (p.lo !== null && p.hi !== null) for (let y = sy(p.hi); y <= sy(p.lo); y += 4) obstacles.push([sx(p.x), y]);
        });
        let best = { score: -Infinity, x: 0, y: 0, angle: 0 };
        for (let t = 0.04; t <= 0.96; t += 0.01) {
          const lx = xa + t * (xb - xa);
          const rad = Math.atan2(sy(trendAt(lx + 0.01)) - sy(trendAt(lx)), sx(lx + 0.01) - sx(lx));
          const [dx, dy] = [Math.cos(rad), Math.sin(rad)];
          // Text centre sits 8px above the line; its box runs ±half along the line, ~10px tall
          const cx = sx(lx) + dy * 8;
          const cy = sy(trendAt(lx)) - dx * 8;
          if (cx - half < m.left || cx + half > m.left + iw) continue;
          let score = Infinity;
          for (const [ox, oy] of obstacles) {
            const along = Math.max(-half, Math.min(half, (ox - cx) * dx + (oy - cy) * dy));
            score = Math.min(score, Math.hypot(ox - (cx + dx * along - dy * 4), oy - (cy + dy * along + dx * 4)));
          }
          if (score > best.score) best = { score, x: cx, y: cy, angle: (rad * 180) / Math.PI };
        }
        tl.setAttribute("x", best.x.toFixed(1));
        tl.setAttribute("y", best.y.toFixed(1));
        tl.setAttribute("transform", `rotate(${best.angle.toFixed(2)} ${best.x.toFixed(1)} ${best.y.toFixed(1)})`);
      }

      // Frontier staircase: holds each record until the next one beats it
      let d = `M${sx(points[0].x)},${sy(points[0].eci)}`;
      for (let i = 1; i < n; i++) d += `H${sx(points[i].x)}V${sy(points[i].eci)}`;
      d += `H${sx(Math.min(X1, xb + 0.06))}`;
      const step = el("path", { class: "step", d, "clip-path": "url(#plot-clip)" }, svg);
      step.style.setProperty("--len", String(Math.ceil(step.getTotalLength())));

      // Points
      positions = [];
      pointNodes = [];
      const layer = el("g", {}, svg);
      points.forEach((p, i) => {
        if (!visible(i)) {
          positions.push(null);
          pointNodes.push(null);
          return;
        }
        const cx = sx(p.x);
        const cy = sy(p.eci);
        positions.push({ cx, cy });
        const g = el(
          "g",
          {
            class: "point",
            tabindex: 0,
            role: "img",
            "aria-label": `${p.name}, ${p.org}, released ${fmtDate(p.date)}, ECI ${p.eci.toFixed(1)}`,
          },
          layer,
        ) as SVGGElement;
        g.style.setProperty("--i", String(i - firstVisible));
        if (p.lo !== null && p.hi !== null) {
          el("line", { class: "whisker", x1: cx, x2: cx, y1: sy(p.lo), y2: sy(p.hi), stroke: colors[p.org] }, g);
        }
        el("circle", { class: "dot", cx, cy, r: 5, fill: colors[p.org] }, g);
        g.addEventListener("focus", () => activate(i));
        g.addEventListener("blur", () => activate(-1));
        pointNodes.push(g);
      });

      // Direct labels on a few models. Each tries a few spots around its dot and takes the one
      // clearest of dots, whiskers, the staircase, the trend line, the zoom toggle and other labels.
      const svgBox = svg.getBoundingClientRect();
      const obstacles: [number, number][] = [];
      const addRect = (x: number, y: number, w: number, h: number) => {
        for (let ox = x; ox <= x + w; ox += 4) for (let oy = y; oy <= y + h; oy += 4) obstacles.push([ox, oy]);
      };
      const addClientRect = (node: Element | null) => {
        if (!node) return;
        const r = node.getBoundingClientRect();
        addRect(r.left - svgBox.left, r.top - svgBox.top, r.width, r.height);
      };
      points.forEach((p, i) => {
        const pos = positions[i];
        if (!pos) return;
        for (let a = 0; a < Math.PI * 2; a += Math.PI / 4) obstacles.push([pos.cx + Math.cos(a) * 5, pos.cy + Math.sin(a) * 5]);
        if (p.lo !== null && p.hi !== null) for (let y = sy(p.hi); y <= sy(p.lo); y += 4) obstacles.push([pos.cx, y]);
        const next = points[i + 1];
        if (next) {
          for (let x = Math.max(m.left, sx(p.x)); x <= sx(next.x); x += 4) obstacles.push([x, sy(p.eci)]);
          for (let y = sy(next.eci); y <= sy(p.eci); y += 4) obstacles.push([sx(next.x), y]);
        }
      });
      for (let x = m.left; x <= m.left + iw; x += 4) obstacles.push([x, sy(trendAt(X0 + ((x - m.left) / iw) * (X1 - X0)))]);
      addClientRect(svg.querySelector(".trend-label"));
      addClientRect(document.getElementById("zoom"));

      const labels = el("g", {}, svg);
      points.forEach((p, i) => {
        const pos = positions[i];
        if (!p.label || !pos) return;
        const { cx, cy } = pos;
        const t = el("text", { class: "label" }, labels);
        t.style.setProperty("--i", String(i - firstVisible)); // fades in with its dot
        t.textContent = p.name.replace(/ \(.*\)$/, "");
        const w = t.getComputedTextLength();
        const h = 11;
        // [x offset, baseline offset, anchor]; the first is this label's usual spot
        const spots: [number, number, "start" | "end"][] = [
          [10, 16, "start"],
          [10, -9, "start"],
          [-10, -9, "end"],
          [-10, 16, "end"],
          [10, 4, "start"],
          [-10, 4, "end"],
        ];
        if (i === n - 1) spots.unshift([-10, -2, "end"]);
        else if (i === 0) spots.unshift([10, -9, "start"]);
        let best = { score: -Infinity, x: 0, y: 0, anchor: "start" };
        spots.forEach(([dx, dy, anchor], k) => {
          const x = cx + dx;
          const y = cy + dy;
          const left = anchor === "start" ? x : x - w;
          const top = y - h + 2;
          if (left < m.left - 30 || left + w > width - 2 || top < 2 || y > m.top + ih + 2) return;
          let clear = Infinity;
          for (const [ox, oy] of obstacles) {
            const ddx = Math.max(left - ox, 0, ox - (left + w));
            const ddy = Math.max(top - oy, 0, oy - (top + h));
            clear = Math.min(clear, Math.hypot(ddx, ddy));
          }
          const score = Math.min(clear, 6) - k * 0.3; // clear enough? then prefer the usual spot
          if (score > best.score) best = { score, x, y, anchor };
        });
        t.setAttribute("x", best.x.toFixed(1));
        t.setAttribute("y", best.y.toFixed(1));
        t.setAttribute("text-anchor", best.anchor);
        addRect(best.anchor === "start" ? best.x : best.x - w, best.y - h + 2, w, h);
      });

      activate = (i: number) => {
        if (activeIndex === i) return;
        activeIndex = i;
        pointNodes.forEach((node, j) => node?.classList.toggle("is-active", j === i));
        if (i < 0 || !positions[i]) {
          tooltip.hidden = true;
          crosshair.setAttribute("visibility", "hidden");
          return;
        }
        const p = points[i];
        const { cx, cy } = positions[i]!;
        crosshair.setAttribute("x1", String(cx));
        crosshair.setAttribute("x2", String(cx));
        crosshair.setAttribute("visibility", "visible");

        document.getElementById("tt-value")!.textContent = p.eci.toFixed(1);
        document.getElementById("tt-name")!.textContent = p.name;
        document.getElementById("tt-horizon")!.textContent = ((d) => (d.startsWith("<") ? d : `~${d}`))(formatDuration(horizonMinutes(horizon, p.eci)));
        (document.getElementById("tt-key") as HTMLElement).style.borderColor = colors[p.org];
        document.getElementById("tt-meta")!.textContent = `${p.org} · ${fmtDate(p.date)}`;
        tooltip.hidden = false;

        const tw = tooltip.offsetWidth;
        const th = tooltip.offsetHeight;
        let left = cx + 14;
        if (left + tw > width) left = cx - 14 - tw;
        left = Math.max(0, left);
        let top = cy - th - 10;
        if (top < 0) top = cy + 14;
        tooltip.style.transform = `translate(${left}px, ${top}px)`;
      };

      firstRender = false;
    }

    // Pointer: nearest point wins, so readers never have to hit a 10px dot
    const onPointer = (e: PointerEvent) => {
      const r = svg.getBoundingClientRect();
      const px = e.clientX - r.left;
      const py = e.clientY - r.top;
      let best = -1;
      let bestD = Infinity;
      positions.forEach((pos, i) => {
        if (!pos) return;
        const dd = (pos.cx - px) ** 2 + ((pos.cy - py) * 0.5) ** 2;
        if (dd < bestD) {
          bestD = dd;
          best = i;
        }
      });
      activate(Math.sqrt(bestD) < 80 ? best : -1);
    };
    svg.addEventListener("pointermove", onPointer);
    svg.addEventListener("pointerdown", onPointer);
    svg.addEventListener("pointerleave", (e) => {
      if (e.pointerType === "mouse") activate(-1);
    });
    // Touch has no hover-out, so a tap anywhere outside the chart clears the selection
    document.addEventListener("pointerdown", (e) => {
      if (!svg.contains(e.target as Node)) activate(-1);
    });

    // Zoom toggle, pinned to the plot's top-left corner
    const zoomButtons = [...document.querySelectorAll<HTMLButtonElement>("#zoom button")];
    for (const button of zoomButtons) {
      button.addEventListener("click", () => {
        const next = button.dataset.view as keyof typeof VIEW_STARTS;
        if (next === view) return;
        view = next;
        zoomButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
        activeIndex = -1;
        tooltip.hidden = true;
        render();
        svg.animate?.([{ opacity: 0.35 }, { opacity: 1 }], { duration: 220, easing: "ease-out" });
      });
    }

    render();
    let lastWidth = chart.clientWidth;
    new ResizeObserver(() => {
      if (chart.clientWidth === lastWidth) return;
      lastWidth = chart.clientWidth;
      activeIndex = -1;
      tooltip.hidden = true;
      render();
    }).observe(chart);
  </script>
</Layout>
