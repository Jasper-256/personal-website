---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="UTF-8 Encoder - Jasper Morgal">
  <h1>UTF-8 Encoder</h1>
  <div id="utf8-tool">
    <section>
      <div id="bits">
        {
          Array.from({ length: 256 }, (_, byte) => (
            <div class="byte">
              {Array.from({ length: 8 }, (_, bit) => (
                <label>
                  <input type="checkbox" data-bit={byte * 8 + bit} />
                </label>
              ))}
              <output class="hex">00</output>
            </div>
          ))
        }
      </div>
    </section>
    <hr />
    <section id="decoded-section">
      <p id="decoded"></p>
    </section>
  </div>
  <script>
    import "@/scripts/utf-8";
  </script>
</Layout>

<style>
  @media (min-width: 551px) {
    :global(.nav-home) {
      margin-left: 8px;
    }
  }

  :global(html) {
    overflow: hidden;
  }

  :global(body) {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 8px);
    margin: 8px 0 0;
    overflow: hidden;
  }

  #utf8-tool {
    display: grid;
    grid-template-columns: 1fr 2px 1fr;
    flex: 1;
    min-height: 0;
  }

  section {
    overflow: auto;
    min-width: 0;
  }

  section:first-child {
    display: grid;
    justify-items: center;
  }

  #bits,
  .byte {
    display: grid;
    gap: 4px;
  }

  #bits {
    font-family: "Menlo", monospace;
    margin: 8px;
  }

  #decoded {
    margin: 6px 8px;
    text-align: left;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .byte {
    grid-template-columns: repeat(8, 18px) 3ch;
    height: 18px;
  }

  input {
    width: 18px;
    height: 18px;
    margin: 0;
  }

  .hex {
    text-align: right;
  }

  hr {
    width: 2px;
    height: auto;
    margin: 0;
  }
</style>
