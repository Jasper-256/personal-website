{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jas-site-astro",
  "account_id": "74fb34d70bac00863c803ec7da668548",
  "main": "src/utf8-worker.ts",
  "compatibility_date": "2025-11-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "UTF8_STATE",
        "class_name": "Utf8State"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Utf8State"]
    }
  ]
}
